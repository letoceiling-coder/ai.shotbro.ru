# Copy to .env.example and .env.production (see docs/SECRETS-SETUP.md)

NODE_ENV=production
APP_URL=https://ai.shotbro.ru
NEXT_PUBLIC_API_URL=https://ai.shotbro.ru

# PostgreSQL (app user — migrations use privileged role on server)
DATABASE_URL=postgresql://shotbro:change-me@postgres:5432/shotbro
POSTGRES_PASSWORD=change-me

# Redis / queues
REDIS_URL=redis://redis:6379

# Better Auth (min 32 chars, rotate if leaked)
BETTER_AUTH_SECRET=
TRUSTED_ORIGINS=https://ai.shotbro.ru,http://localhost:3000

S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru
S3_REGION=ru-3
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PRESIGNED_URL_TTL_SECONDS=300
S3_MAX_UPLOAD_SIZE_MB=500

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=false
OPENROUTER_ALLOW_PAID_REQUESTS=false
OPENROUTER_DEFAULT_MODEL=
OPENROUTER_MAX_COST_USD=0

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=SHOTBRO AI Studio
EMAIL_ENABLED=false
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_TOKEN_TTL_MINUTES=60
EMAIL_RATE_LIMIT_PER_HOUR=5
