{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "paths": {
      "@shotbro/db": ["../../packages/db/src/index.ts"],
      "@shotbro/db/*": ["../../packages/db/src/*"],
      "@shotbro/config": ["../../packages/config/src/index.ts"],
      "@shotbro/config/*": ["../../packages/config/src/*"]
    }
  },
  "include": ["src/**/*", "test/**/*"]
}
