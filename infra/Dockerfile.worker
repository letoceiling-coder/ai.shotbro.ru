ARG BUILD_SHA=unknown
FROM node:22-alpine AS deps
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/worker/package.json apps/worker/
COPY packages/agent-core/package.json packages/agent-core/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/contracts/package.json packages/contracts/
COPY packages/db/package.json packages/db/
COPY packages/email/package.json packages/email/
COPY packages/provider-sdk/package.json packages/provider-sdk/
RUN pnpm config set verify-deps-before-run false \
  && pnpm config set strict-dep-builds false \
  && pnpm install --frozen-lockfile --filter worker...

FROM node:22-alpine AS builder
ARG BUILD_SHA
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/worker/node_modules ./apps/worker/node_modules
COPY . .
RUN echo "${BUILD_SHA}" >/tmp/.shotbro-build-sha
RUN pnpm --filter worker run typecheck 2>/dev/null || true

FROM node:22-alpine AS runner
ARG BUILD_SHA
LABEL org.shotbro.build-sha="${BUILD_SHA}"
RUN apk add --no-cache vips-dev fftw-dev build-base python3 ffmpeg
WORKDIR /app
ENV NODE_ENV=production
RUN corepack enable && corepack prepare pnpm@11.5.1 --activate
COPY --from=builder /app /app
CMD ["pnpm", "exec", "tsx", "--tsconfig", "apps/worker/tsconfig.json", "apps/worker/src/main.ts"]
