# Copy to staging.env on VPS (chmod 600). Do NOT commit staging.env

STAGING_POSTGRES_PASSWORD=generate-long-random
STAGING_MINIO_USER=shotbro_staging_minio
STAGING_MINIO_PASSWORD=generate-long-random
BETTER_AUTH_SECRET=generate-at-least-32-random-bytes-base64
# Public register off by default; enable only for isolated integration runs.
ALLOW_PUBLIC_REGISTER=false
PHASE4_AGENT_RUNTIME_ENABLED=false
PHASE4_PROJECT_SCOPED_ENABLED=false
# Comma-separated emails allowed to POST .../agent/runtime-rollout (staging operators / E2E user A)
PHASE4_ROLLOUT_ADMIN_EMAILS=e2e-phase2@shotbro.test
# Loopback-only CI rollout (docker exec); set secret on VPS only
INTEGRATION_ROLLOUT_ENABLED=false
# INTEGRATION_ROLLOUT_SECRET=
STAGING_GATE_SECRET=generate-at-least-16-chars
# Staging-only: enable CLI/loopback provisioning (never on production cutover)
INTEGRATION_PROVISION_ENABLED=false
# Optional HTTP fallback: loopback inside API container only (docker exec curl 127.0.0.1:3001)
INTEGRATION_PROVISION_SECRET=generate-at-least-32-chars
INTEGRATION_USER_A_EMAIL=e2e-phase2@shotbro.test
INTEGRATION_USER_B_EMAIL=e2e-phase2-b@shotbro.test
# Set INTEGRATION_USER_A_PASSWORD / INTEGRATION_USER_B_PASSWORD in staging.env (never commit)
# Origin only (no /minio-storage path) — nginx proxies /{S3_BUCKET}/ to MinIO
S3_PUBLIC_ENDPOINT=https://ai.shotbro.ru

# Production Selectel — BLOCKED until owner provides NEW keys (never use leaked credentials)
# S3_ENDPOINT=https://s3.ru-3.storage.selcloud.ru
# S3_BUCKET=shotbro-prod
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# SMTP (Beget: smtp.beget.com:465, implicit TLS). Canonical keys — aliases SMTP_PASS / SMTP_FROM also work.
SMTP_HOST=smtp.beget.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@shotbro.ru
SMTP_PASSWORD=
SMTP_FROM_EMAIL=info@shotbro.ru
SMTP_FROM_NAME=SHOTBRO AI Studio
EMAIL_ENABLED=false
# Set false on staging until public register + verify flow is fully tested
EMAIL_VERIFICATION_REQUIRED=false
LEAD_NOTIFY_EMAIL=info@shotbro.ru

# Magnific (set on VPS only in staging.env — never commit values)
# MAGNIFIC_API_KEY=
# MAGNIFIC_WEBHOOK_SECRET=
# MAGNIFIC_PROVIDER_ENABLED=false

# Phase 5K — OpenRouter creative LLM (independent of media; compose defaults keep media off)
# OPENROUTER_API_KEY=sk-or-v1-...  # VPS only
# OPENROUTER_ENABLED=true
# LLM_LIVE_EXECUTION_ENABLED=true
# OPENROUTER_CONNECT_MODE=auto
# OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
# OPENROUTER_MODEL_ALLOWLIST=openai/gpt-4o-mini
# OPENROUTER_MAX_COST_USD=0.15
# CREATIVE_AGENT_RUN_MAX_COST_USD=0.12
# CREATIVE_AGENT_MAX_ITERATIONS=6
# CREATIVE_AGENT_MAX_TOOL_CALLS=12
# CREATIVE_AGENT_MAX_OUTPUT_TOKENS=1536
# CREATIVE_AGENT_MAX_DURATION_MS=90000
# OPENROUTER_USER_DAILY_MAX_USD=2.0
# MEDIA_GENERATION_ENABLED=false
# IMAGE_GENERATION_ENABLED=false
# VIDEO_GENERATION_ENABLED=false
# MEDIA_PROVIDER_LIVE_EXECUTION_ENABLED=false
